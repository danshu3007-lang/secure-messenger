# systemd/messenger-receive.service
#
# Installation:
#   sudo cp systemd/messenger-receive.service /etc/systemd/system/
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin messenger
#   sudo chown -R messenger:messenger /etc/messenger/certs
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now messenger-receive
#
# View logs (metadata only — no message content when --quiet is set):
#   sudo journalctl -u messenger-receive -f

[Unit]
Description=Secure Stateless Messenger Receiver
Documentation=https://github.com/yourorg/secure-messenger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=messenger
Group=messenger

# --quiet suppresses message content from stdout.
# This means journald will never receive message content.
# Remove --quiet only if you are running interactively and
# explicitly want messages visible in the terminal.
ExecStart=/usr/bin/messenger-receive 8443 --quiet

# Graceful reload (re-exec the process)
ExecReload=/bin/kill -HUP $MAINPID

# ── Sandboxing & hardening ────────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes                  # Isolated /tmp — no temp-file leakage
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes      # Prevents JIT / shellcode injection
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Allow read access to certs only
ReadOnlyPaths=/etc/messenger/certs
ReadWritePaths=

# ── Logging ───────────────────────────────────────────────────────────────────
# stdout/stderr go to journald.
# With --quiet, only connection metadata (IP, port, errors) is printed.
# Message CONTENT is never printed when --quiet is active.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=messenger-receive

# ── Restart policy ───────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
